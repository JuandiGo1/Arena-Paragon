datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================
// ENUMS
// ============================================================

enum EventStatus {
  DRAFT
  OPEN
  IN_PROGRESS
  FINISHED
  CANCELLED
}

enum MatchStatus {
  PENDING
  OPEN
  CLOSED
  FINISHED
  CANCELLED
}

enum BetStatus {
  PENDING
  WON
  LOST
  CANCELLED
}

enum ScrollType {
  SHINOBI
  PARAGONIO
  EVENT
  SPECIAL
}

enum CardUseStatus {
  PENDING
  RESOLVED
  CANCELLED
}

// ============================================================
// USER
// ============================================================

model User {
  id              String @id @default(cuid())
  discordId       String @unique
  discordUsername String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  eventParticipants EventParticipant[]
  bets              Bet[]
  userCards         UserCard[]
  userScrolls       UserScroll[]
  cardUses          CardUse[] @relation("CardUseUser")
  targetCardUses    CardUse[] @relation("CardUseTarget")

  @@index([discordId])
}

// ============================================================
// EVENT
// ============================================================

model Event {
  id                 String      @id @default(cuid())
  name               String
  startingParagonita Int         @default(100)
  status             EventStatus @default(DRAFT)

  useStreaks        Boolean @default(false)
  streakMultipliers Json?

  allowCards Boolean @default(false)

  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  participants EventParticipant[]
  matches      Match[]
  cardUses     CardUse[]

  @@index([status])
  @@index([createdAt])
}

// ============================================================
// PARTICIPACIÓN DE UN USUARIO EN UN EVENTO
// ============================================================

model EventParticipant {
  id String @id @default(cuid())

  eventId String
  userId  String

  startingBalance Int
  currentBalance  Int

  totalWagered Int @default(0)
  totalWon     Int @default(0)
  totalLost    Int @default(0)

  currentStreak Int @default(0)
  highestStreak Int @default(0)

  cardsBanned Boolean @default(false)

  joinedAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Restrict)
  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)

  bets Bet[]

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

// ============================================================
// MATCH / COMBATE
// ============================================================

model Match {
  id String @id @default(cuid())

  eventId String
  number  Int

  competitorA String
  competitorB String

  winner String?
  status MatchStatus @default(PENDING)

  createdAt  DateTime  @default(now())
  openedAt   DateTime?
  closedAt   DateTime?
  resolvedAt DateTime?

  event    Event    @relation(fields: [eventId], references: [id], onDelete: Restrict)
  bets     Bet[]
  cardUses CardUse[]

  @@unique([eventId, number])
  @@index([eventId])
  @@index([status])
}

// ============================================================
// APUESTA
// ============================================================

model Bet {
  id String @id @default(cuid())

  userId             String
  eventParticipantId String
  matchId            String

  competitor String
  amount     Int
  ownAmount  Int @default(0)

  status BetStatus @default(PENDING)

  streakBefore Int @default(0)
  streakAfter  Int @default(0)

  multiplier Float?
  payout     Int?
  netResult  Int?

  rewardCharacterName String?

  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
  cancelledAt DateTime?

  user             User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  eventParticipant EventParticipant @relation(fields: [eventParticipantId], references: [id], onDelete: Restrict)
  match            Match            @relation(fields: [matchId], references: [id], onDelete: Restrict)

  cards    BetCard[]
  cardUses CardUse[]

  @@unique([eventParticipantId, matchId])
  @@index([userId])
  @@index([eventParticipantId])
  @@index([matchId])
  @@index([status])
}

// ============================================================
// CARTAS
// ============================================================

model Card {
  id String @id @default(cuid())

  name        String  @unique
  description String
  imageUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userCards    UserCard[]
  betCards     BetCard[]
  cardUses     CardUse[] @relation("CardUseCard")
  copiedInUses CardUse[] @relation("CardUseCopied")
}

// ============================================================
// INVENTARIO DE CARTAS DEL USUARIO
// ============================================================

model UserCard {
  id String @id @default(cuid())

  userId String
  cardId String

  quantity Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  card Card @relation(fields: [cardId], references: [id], onDelete: Restrict)

  @@unique([userId, cardId])
  @@index([userId])
  @@index([cardId])
}

// ============================================================
// CARTA UTILIZADA EN UNA APUESTA (legacy)
// ============================================================

model BetCard {
  id String @id @default(cuid())

  betId  String
  cardId String

  effectResult String?

  createdAt DateTime @default(now())

  bet  Bet  @relation(fields: [betId], references: [id], onDelete: Restrict)
  card Card @relation(fields: [cardId], references: [id], onDelete: Restrict)

  @@unique([betId, cardId])
  @@index([betId])
  @@index([cardId])
}

// ============================================================
// USO DE CARTA EN UN COMBATE
// ============================================================

model CardUse {
  id String @id @default(cuid())

  userId  String
  cardId  String
  eventId String
  matchId String
  betId   String?

  // Target user (for Bardo and Brujo-as-Bardo)
  targetUserId String?
  // For Brujo: which card was copied
  copiedCardId String?

  // JSON blob: { actingAs?, actingAsCardId?, sourceCardUseId?, targetDiscordId?, targetUserId? }
  effectData   String?
  // JSON blob written at resolution: { targetWon?, bonusApplied?, penalty? }
  effectResult String?

  status     CardUseStatus @default(PENDING)
  resolvedAt DateTime?
  createdAt  DateTime      @default(now())

  user       User  @relation("CardUseUser",   fields: [userId],       references: [id], onDelete: Restrict)
  card       Card  @relation("CardUseCard",   fields: [cardId],       references: [id], onDelete: Restrict)
  event      Event @relation(                 fields: [eventId],      references: [id], onDelete: Restrict)
  match      Match @relation(                 fields: [matchId],      references: [id], onDelete: Restrict)
  bet        Bet?  @relation(                 fields: [betId],        references: [id], onDelete: Restrict)
  targetUser User? @relation("CardUseTarget", fields: [targetUserId], references: [id], onDelete: Restrict)
  copiedCard Card? @relation("CardUseCopied", fields: [copiedCardId], references: [id], onDelete: Restrict)

  @@unique([userId, matchId])
  @@index([matchId])
  @@index([eventId])
  @@index([userId])
}

// ============================================================
// PERGAMINOS
// ============================================================

model Scroll {
  id String @id @default(cuid())

  name        String
  type        ScrollType
  description String?

  createdAt DateTime @default(now())

  userScrolls UserScroll[]

  @@unique([name, type])
}

// ============================================================
// INVENTARIO DE PERGAMINOS
// ============================================================

model UserScroll {
  id String @id @default(cuid())

  userId   String
  scrollId String

  quantity Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  scroll Scroll @relation(fields: [scrollId], references: [id], onDelete: Restrict)

  @@unique([userId, scrollId])
  @@index([userId])
  @@index([scrollId])
}
